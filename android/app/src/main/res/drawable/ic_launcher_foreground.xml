<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Monitor Outer Body / Bezel with Rounded Corners -->
    <path
        android:pathData="M28,29 h52 a4,4 0 0,1 4,4 v33 a4,4 0 0,1 -4,4 h-52 a4,4 0 0,1 -4,-4 v-33 a4,4 0 0,1 4,-4 z"
        android:strokeWidth="1.8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="29"
                android:endX="84"
                android:endY="70"
                android:type="linear">
                <item android:color="#212D45" android:offset="0.0" />
                <item android:color="#161F33" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="29"
                android:endX="84"
                android:endY="70"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#2979FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Monitor Inner Screen Glass -->
    <path
        android:pathData="M27.5,32.5 h53 a1.5,1.5 0 0,1 1.5,1.5 v26 a1.5,1.5 0 0,1 -1.5,1.5 h-53 a1.5,1.5 0 0,1 -1.5,-1.5 v-26 a1.5,1.5 0 0,1 1.5,-1.5 z"
        android:fillColor="#0E1626" />

    <!-- Monitor Stand Neck -->
    <path
        android:pathData="M51,70 h6 v8 h-6 z"
        android:fillColor="#1E293B"
        android:strokeColor="#2979FF"
        android:strokeWidth="1" />

    <!-- Monitor Stand Base -->
    <path
        android:pathData="M43,78 h22 a2,2 0 0,1 2,2 v1 h-26 v-1 a2,2 0 0,1 2,-2 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41"
                android:startY="78"
                android:endX="67"
                android:endY="81"
                android:type="linear">
                <item android:color="#2979FF" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized "W" Brand Emblem Inside Display -->
    <path
        android:pathData="M34,40 L40.5,56 L47,43 L53.5,43 L60,56 L66.5,40"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="40"
                android:endX="66.5"
                android:endY="56"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="0.5" />
                <item android:color="#818CF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Remote Wireless Broadcast Indicator Waves (Top Right) -->
    <path
        android:pathData="M70,30 A12,12 0 0,1 78,38"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M73,27 A17,17 0 0,1 84,38"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.4"
        android:strokeLineCap="round" />

    <!-- Precise Interactive Pointer Cursor (Overlay at bottom right of screen) -->
    <path
        android:pathData="M59,52 L59,65 L63,61 L67,68 L69,67 L65,60 L70,60 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#0288D1"
        android:strokeWidth="1"
        android:strokeLineJoin="round" />

</vector>